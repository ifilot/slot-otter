# Keep MS-DOS source files checked out with DOS line endings.
src/*.ASM text eol=crlf
src/*.C text eol=crlf
src/*.H text eol=crlf
src/*.PRJ text eol=crlf
src/*.BAT text eol=crlf
src/*.INC text eol=crlf
src/MAKEFILE text eol=crlf
src/README.MD text eol=crlf
driver/*.ASM text eol=crlf
driver/*.C text eol=crlf
driver/*.H text eol=crlf
driver/*.BAT text eol=crlf
driver/*.INC text eol=crlf
driver/MAKEFILE text eol=crlf
driver/tests/*.C text eol=crlf
driver/tests/*.H text eol=crlf
driver/tests/*.ASM text eol=crlf
driver/tests/*.BAT text eol=crlf
driver/tests/*.INC text eol=crlf
driver/tests/reference/*.C text eol=crlf
driver/tests/reference/*.H text eol=crlf
driver/tests/reference/*.ASM text eol=crlf
# Host-side scripts and emulator code use Unix line endings.
*.sh text eol=lf
*.py text eol=lf
driver/tests/emulation/*.c text eol=lf
driver/tests/emulation/*.h text eol=lf
driver/tests/emulation/**/*.c text eol=lf
driver/tests/emulation/**/*.h text eol=lf
driver/tests/emulation/**/*.cpp text eol=lf
driver/hardware/*.C text eol=crlf
driver/hardware/*.BAT text eol=crlf
driver/write/*.C text eol=crlf
driver/write/*.H text eol=crlf
