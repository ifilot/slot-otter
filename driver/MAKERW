OTTERWR.EXE: MAINRW.OBJ CRT.OBJ PORT.OBJ RWDIR.OBJ RWFS.OBJ FAT32.OBJ SDRW.OBJ ENTRY.OBJ
	tcc -ms -M -eOTTERWR.EXE MAINRW.OBJ CRT.OBJ PORT.OBJ RWDIR.OBJ RWFS.OBJ FAT32.OBJ SDRW.OBJ ENTRY.OBJ

MAINRW.OBJ: MAINRW.C MAIN.C OTTER.H RWSD.H
	tcc -ms -O -d -Z -c MAINRW.C
CRT.OBJ: CRT.C
	tcc -ms -O -d -Z -c CRT.C
PORT.OBJ: PORT.C OTTER.H
	tcc -ms -O -d -Z -c PORT.C
RWDIR.OBJ: RWDIR.C REDIR.C RWOPS.C OTTER.H RWFS.H RWSD.H
	tcc -ms -O -d -Z -c RWDIR.C
RWFS.OBJ: RWFS.C RWFS.H RWSD.H OTTER.H
	tcc -ms -O -d -Z -c RWFS.C
FAT32.OBJ: FAT32.C OTTER.H
	tcc -ms -O -d -Z -c FAT32.C
SDRW.OBJ: SDRW.C RWSD.H OTTER.H
	tcc -ms -O -d -Z -c SDRW.C
ENTRY.OBJ: ENTRY.ASM
	tasm /mx ENTRY.ASM
