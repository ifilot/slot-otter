OTTERFS.EXE: MAIN.OBJ CRT.OBJ PORT.OBJ REDIR.OBJ FAT32.OBJ SD.OBJ ENTRY.OBJ SDCMDS.OBJ
	tcc -ms -M -eOTTERFS.EXE MAIN.OBJ CRT.OBJ PORT.OBJ REDIR.OBJ FAT32.OBJ SD.OBJ ENTRY.OBJ SDCMDS.OBJ

MAIN.OBJ: MAIN.C OTTER.H
	tcc -ms -O -d -Z -c MAIN.C
CRT.OBJ: CRT.C
	tcc -ms -O -d -Z -c CRT.C
PORT.OBJ: PORT.C OTTER.H
	tcc -ms -O -d -Z -c PORT.C
REDIR.OBJ: REDIR.C OTTER.H
	tcc -ms -O -d -Z -c REDIR.C
FAT32.OBJ: FAT32.C OTTER.H
	tcc -ms -O -d -Z -c FAT32.C
SD.OBJ: SD.C OTTER.H
	tcc -ms -O -d -Z -c SD.C
ENTRY.OBJ: ENTRY.ASM
	tasm /mx ENTRY.ASM
SDCMDS.OBJ: SDCMDS.ASM
	tasm /mx SDCMDS.ASM

clean:
	del *.OBJ
	del OTTERFS.EXE
	del OTTERFS.MAP
