OTTERWR.EXE: BOOT.OBJ CRT.OBJ RWDIR.OBJ RWFS.OBJ FAT32.OBJ SDRW.OBJ ENTRY.OBJ INSTALL.OBJ
	tcc -ms -M -eOTTERWR.EXE BOOT.OBJ CRT.OBJ RWDIR.OBJ RWFS.OBJ FAT32.OBJ SDRW.OBJ ENTRY.OBJ INSTALL.OBJ
BOOT.OBJ: BOOT.C INSTALL.H OTTER.H
	tcc -ms -O -d -Z -c BOOT.C
CRT.OBJ: CRT.C
	tcc -ms -O -d -Z -c CRT.C
RWDIR.OBJ: RWDIR.C REDIR.C RWOPS.C OTTER.H RWFS.H RWSD.H
	tcc -ms -O -d -Z -c RWDIR.C
RWFS.OBJ: RWFS.C RWFS.H RWSD.H OTTER.H
	tcc -ms -O -d -Z -c RWFS.C
FAT32.OBJ: FAT32.C OTTER.H
	tcc -ms -O -d -Z -c FAT32.C
SDRW.OBJ: SDRW.C RWSD.H OTTER.H
	tcc -ms -O -d -Z -c SDRW.C
ENTRY.OBJ: ENTRY.ASM
	tasm /mx ENTRY.ASM
INSTALL.OBJ: INSTALL.ASM
	tasm /mx INSTALL.ASM
